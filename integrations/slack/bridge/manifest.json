{
  "display_information": {
    "name": "Approval intake",
    "description": "Mention-only proposals for human organizer review"
  },
  "features": {
    "bot_user": {
      "display_name": "Approval intake",
      "always_online": false
    }
  },
  "oauth_config": {
    "scopes": {
      "bot": ["app_mentions:read", "chat:write", "groups:read"]
    }
  },
  "settings": {
    "event_subscriptions": {
      "bot_events": ["app_mention"]
    },
    "socket_mode_enabled": true,
    "org_deploy_enabled": false,
    "token_rotation_enabled": false
  }
}
